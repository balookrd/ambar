    {
      "type": "table",
      "id": 1,
      "title": "Интерфейсы ($interface)",
      "description": "Статус, скорость линка (для физических портов), текущий RX/TX (бит/с), ошибки и сбросы по IF-MIB / ifXTable.",
      "datasource": {
        "type": "prometheus",
        "uid": "adnsc1wi03doga"
      },
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 1
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "adnsc1wi03doga"
          },
          "expr": "max by (ifIndex, ifName, ifAlias, ifDescr) (ifOperStatus{job=\"netcraze-snmp\",ifName=~\"$interface\"})",
          "instant": true,
          "format": "table"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "adnsc1wi03doga"
          },
          "expr": "max by (ifIndex, ifName, ifAlias, ifDescr) (ifHighSpeed{job=\"netcraze-snmp\",ifName=~\"$interface\"})",
          "instant": true,
          "format": "table"
        },
        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "adnsc1wi03doga"
          },
          "expr": "sum by (ifIndex, ifName, ifAlias, ifDescr) (rate(ifHCInOctets{job=\"netcraze-snmp\",ifName=~\"$interface\"}[2m]) * 8)",
          "instant": true,
          "format": "table"
        },
        {
          "refId": "D",
          "datasource": {
            "type": "prometheus",
            "uid": "adnsc1wi03doga"
          },
          "expr": "sum by (ifIndex, ifName, ifAlias, ifDescr) (rate(ifHCOutOctets{job=\"netcraze-snmp\",ifName=~\"$interface\"}[2m]) * 8)",
          "instant": true,
          "format": "table"
        },
        {
          "refId": "E",
          "datasource": {
            "type": "prometheus",
            "uid": "adnsc1wi03doga"
          },
          "expr": "sum by (ifIndex, ifName, ifAlias, ifDescr) (rate(ifInErrors{job=\"netcraze-snmp\",ifName=~\"$interface\"}[5m]) + rate(ifOutErrors{job=\"netcraze-snmp\",ifName=~\"$interface\"}[5m]))",
          "instant": true,
          "format": "table"
        },
        {
          "refId": "F",
          "datasource": {
            "type": "prometheus",
            "uid": "adnsc1wi03doga"
          },
          "expr": "sum by (ifIndex, ifName, ifAlias, ifDescr) (rate(ifInDiscards{job=\"netcraze-snmp\",ifName=~\"$interface\"}[5m]) + rate(ifOutDiscards{job=\"netcraze-snmp\",ifName=~\"$interface\"}[5m]))",
          "instant": true,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
