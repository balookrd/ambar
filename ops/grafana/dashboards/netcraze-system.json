        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "adnsc1wi03doga"
          },
          "expr": "100 * (memTotalReal{job=\"netcraze-snmp\"} - memAvailReal{job=\"netcraze-snmp\"} - memBuffer{job=\"netcraze-snmp\"} - memCached{job=\"netcraze-snmp\"}) / memTotalReal{job=\"netcraze-snmp\"}",
          "legendFormat": "RAM",
          "instant": true
