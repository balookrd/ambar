    {
      "type": "stat",
      "id": 4,
      "title": "CPU",
      "description": "Суммарная загрузка CPU за 5 минут (User + Nice + System относительно всех тиков).",
      "datasource": {
        "type": "prometheus",
        "uid": "adnsc1wi03doga"
      },
      "gridPos": {
        "h": 4,
        "w": 2,
        "x": 14,
        "y": 1
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "adnsc1wi03doga"
          },
          "expr": "100 * (rate(ssCpuRawUser{job=\"netcraze-snmp\"}[5m]) + rate(ssCpuRawNice{job=\"netcraze-snmp\"}[5m]) + rate(ssCpuRawSystem{job=\"netcraze-snmp\"}[5m])) / clamp_min(rate(ssCpuRawUser{job=\"netcraze-snmp\"}[5m]) + rate(ssCpuRawNice{job=\"netcraze-snmp\"}[5m]) + rate(ssCpuRawSystem{job=\"netcraze-snmp\"}[5m]) + rate(ssCpuRawIdle{job=\"netcraze-snmp\"}[5m]), 1e-6)",
          "legendFormat": "CPU",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 70
              },
              {
                "color": "red",
                "value": 90
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "area"
      }
    },
    {
      "type": "stat",
      "id": 5,
      "title": "RAM (реальная)",
      "description": "Реально занятая память без освобождаемых буферов и page cache: (memTotalReal - memAvailReal - memBuffer - memCached) / memTotalReal.",
