                                "type": "string"
                              },
                              "peerDisk": {
                                "type": "string"
                              },
                              "state": {
                                "type": "string"
                              }
                            },
                            "required": [
                              "peer",
                              "peerDisk",
                              "state"
                            ],
                            "type": "object"
                          },
                          "type": "array"
                        },
                        "disk": {
                          "description": "DRBD disk state of the local volume 0; `Diskless` for a node without a disk.",
                          "type": "string"
                        },
                        "message": {
                          "default": "",
                          "description": "Last error of the reconcile on this node; empty when the last pass succeeded.",
                          "type": "string"
                        },
                        "name": {
                          "type": "string"
                        },
                        "quorum": {
                          "type": "boolean"
                        },
                        "role": {
                          "description": "`Primary`, `Secondary` or `Unknown`.",
                          "type": "string"
                        }
                      },
                      "required": [
                        "connections",
                        "disk",
                        "name",
                        "quorum",
                        "role"
                      ],
                      "type": "object"
                    },
                    "type": "array",
                    "x-kubernetes-list-map-keys": [
                      "name"
                    ],
                    "x-kubernetes-list-type": "map"
                  }
                },
                "type": "object"
              }
            },
            "required": [
              "spec"
            ],
            "title": "ReplicatedVolume",
            "type": "object"
          }
        },
